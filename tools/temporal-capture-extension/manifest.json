{
  "manifest_version": 3,
  "name": "TheLord Temporal Capture (Local Test)",
  "version": "1.0.0",
  "description": "Captura frames WebSocket somente em páginas locais de teste e envia cópias ao relay temporal.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*","http://localhost/*","https://127.0.0.1/*","https://localhost/*"],"js": ["bridge.js"],"run_at": "document_start","world": "ISOLATED"},
    {"matches": ["http://127.0.0.1/*","http://localhost/*","https://127.0.0.1/*","https://localhost/*"],"js": ["page-hook.js"],"run_at": "document_start","world": "MAIN"}
  ]
}